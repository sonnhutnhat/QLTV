<%- include ('../../partials/header.ejs') %>

    <style>
        :root {
            --primary-gradient: linear-gradient(135deg, #667eea 0%, #764ba2 100%);
            --success-gradient: linear-gradient(135deg, #11998e 0%, #38ef7d 100%);
            --danger-gradient: linear-gradient(135deg, #ee0979 0%, #ff6a00 100%);
            --info-gradient: linear-gradient(135deg, #3a7bd5 0%, #00d2ff 100%);
            --card-gradient: linear-gradient(135deg, #fdfbfb 0%, #ebedee 100%);
        }

        body {
            background: linear-gradient(135deg, #f5f7fa 0%, #c3cfe2 100%);
            min-height: 100vh;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        /* Search Bar Section */
        #search_bar {
            background: white !important;
            border-radius: 20px;
            padding: 2rem !important;
            box-shadow: 0 10px 40px rgba(0, 0, 0, 0.1);
            margin-bottom: 3rem;
        }

        #search_bar .row {
            align-items: stretch;
        }

        .form-control,
        select.form-control {
            border-radius: 12px;
            border: 2px solid #e0e0e0;
            padding: 0 20px;
            transition: all 0.3s ease;
            height: 48px;
            line-height: 48px;
        }

        .form-control:focus,
        select.form-control:focus {
            border-color: #667eea;
            box-shadow: 0 0 0 0.2rem rgba(102, 126, 234, 0.25);
        }

        .btn-outline-primary {
            background: var(--primary-gradient);
            border: none;
            border-radius: 12px;
            padding: 0 30px;
            color: white !important;
            font-weight: 600;
            transition: all 0.3s ease;
            height: 48px;
            width: 100%;
        }

        .btn-outline-primary:hover {
            transform: translateY(-2px);
            box-shadow: 0 8px 20px rgba(102, 126, 234, 0.4);
        }

        /* Books Grid */
        #browse_books {
            margin-bottom: 4rem;
        }

        .books-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 2rem;
            margin-bottom: 3rem;
        }

        /* Book Card */
        .book-card {
            background: white;
            border-radius: 20px;
            overflow: hidden;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
            transition: all 0.4s ease;
            border: none;
            display: flex;
            flex-direction: column;
            height: 100%;
        }

        .book-card:hover {
            transform: translateY(-10px) scale(1.02);
            box-shadow: 0 20px 50px rgba(102, 126, 234, 0.3);
        }

        .book-card-header {
            background: var(--primary-gradient);
            padding: 2rem 1.5rem;
            text-align: center;
            position: relative;
            overflow: hidden;
        }

        .book-card-header::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(255, 255, 255, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            0% {
                transform: rotate(0deg);
            }

            100% {
                transform: rotate(360deg);
            }
        }

        .book-icon {
            font-size: 3rem;
            color: white;
            margin-bottom: 1rem;
            position: relative;
            z-index: 1;
        }

        .book-card-body {
            padding: 1.5rem;
            text-align: center;
            flex: 1;
            display: flex;
            flex-direction: column;
        }

        .book-title {
            font-size: 1.3rem;
            font-weight: 700;
            color: #333;
            margin-bottom: 1rem;
            min-height: 60px;
            display: flex;
            align-items: center;
            justify-content: center;
            line-height: 1.3;
        }

        .book-info {
            margin-bottom: 0.75rem;
            color: #666;
            font-size: 0.95rem;
        }

        .book-info i {
            color: #667eea;
            margin-right: 6px;
            width: 18px;
        }

        .book-info strong {
            color: #333;
        }

        .book-category {
            display: inline-block;
            background: linear-gradient(135deg, #f093fb 0%, #f5576c 100%);
            color: white;
            padding: 6px 16px;
            border-radius: 20px;
            font-size: 0.85rem;
            font-weight: 600;
            margin-bottom: 1.5rem;
        }

        .btn-view {
            background: var(--info-gradient);
            border: none;
            border-radius: 12px;
            padding: 12px 30px;
            color: white;
            font-weight: 600;
            transition: all 0.3s ease;
            text-decoration: none;
            display: inline-block;
            margin-top: auto;
        }

        .btn-view:hover {
            transform: translateY(-2px);
            box-shadow: 0 6px 20px rgba(58, 123, 213, 0.4);
            color: white;
            text-decoration: none;
        }

        .btn-view i {
            margin-right: 6px;
        }

        /* Pagination */
        .page-link {
            border-radius: 8px;
            margin: 0 3px;
            border: 2px solid #e0e0e0;
            color: #667eea;
            font-weight: 600;
            transition: all 0.3s ease;
        }

        .page-link:hover {
            background: var(--primary-gradient);
            color: white !important;
            border-color: transparent;
            transform: translateY(-2px);
        }

        .page-item.active .page-link {
            background: var(--primary-gradient);
            border-color: transparent;
            color: white !important;
        }

        .page-item.disabled .page-link {
            background: #f5f5f5;
            border-color: #e0e0e0;
        }

        .pagination {
            justify-content: center;
            margin-top: 2rem;
            margin-bottom: 2rem;
        }

        /* Empty State */
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: white;
            border-radius: 20px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.1);
        }

        .empty-state i {
            font-size: 5rem;
            color: #ddd;
            margin-bottom: 1rem;
        }

        .empty-state h3 {
            color: #666;
            font-weight: 600;
        }

        /* Responsive */
        @media (max-width: 768px) {
            .books-grid {
                grid-template-columns: 1fr;
            }

            #search_bar {
                padding: 1.5rem !important;
            }
        }

        /* Loading Animation */
        @keyframes fadeInUp {
            from {
                opacity: 0;
                transform: translateY(20px);
            }

            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .book-card {
            animation: fadeInUp 0.5s ease-out;
        }

        .book-card:nth-child(1) {
            animation-delay: 0.1s;
        }

        .book-card:nth-child(2) {
            animation-delay: 0.2s;
        }

        .book-card:nth-child(3) {
            animation-delay: 0.3s;
        }

        .book-card:nth-child(4) {
            animation-delay: 0.4s;
        }

        .book-card:nth-child(5) {
            animation-delay: 0.5s;
        }

        .book-card:nth-child(6) {
            animation-delay: 0.6s;
        }
    </style>
    </head>

    <body>
        <%- include ("../../partials/userNav.ejs") %>

            <!--SEARCH BAR-->
            <section id="search_bar" class="my-3 py-4 bg-light">
                <div class="container">
                    <form action="" method="POST">
                        <div class="row">
                            <div class="col-md-5 p-1">
                                <select name="filter" class="form-control" required>
                                    <option selected disabled>Select Filter...</option>
                                    <option name="title">Title</option>
                                    <option name="author">Author</option>
                                    <option name="category">Category</option>
                                </select>
                            </div>

                            <div class="col-md-5 p-1">
                                <input name="searchName" type="text" class="form-control" placeholder="Search Books"
                                    required>
                            </div>

                            <div class="col-md-2 p-1">
                                <input type="submit" class="btn btn-outline-primary btn-block" value="Search">
                            </div>
                        </div>
                    </form>
                </div>
            </section>

            <%- include ('../../partials/alerts.ejs') %>

                <!--BOOKS-->
                <section id="browse_books" class="mt-5">
                    <div class="container">
                        <% if (books && books.length> 0) { %>
                            <div class="books-grid">
                                <% for(var i=0; i < books.length; i++) { %>
                                    <div class="book-card">
                                        <div class="book-card-header">
                                            <div class="book-icon">
                                                <i class="fa fa-book-open"></i>
                                            </div>
                                        </div>
                                        <div class="book-card-body">
                                            <h5 class="book-title">
                                                <%=books[i].title%>
                                            </h5>

                                            <div class="book-info">
                                                <i class="fa fa-user"></i>
                                                <strong>Author:</strong>
                                                <%=books[i].author%>
                                            </div>

                                            <div class="book-info">
                                                <i class="fa fa-bookmark"></i>
                                                <strong>Category:</strong>
                                                <span class="book-category">
                                                    <%=books[i].category%>
                                                </span>
                                            </div>

                                            <a href="/user/<%= currentUser.username %>/books/detail/<%= books[i]._id %>"
                                                class="btn-view">
                                                <i class="fa fa-eye"></i> View Details
                                            </a>
                                        </div>
                                    </div>
                                    <% } %>
                            </div>
                            <% } else { %>
                                <div class="empty-state">
                                    <i class="fa fa-book"></i>
                                    <h3>No books found</h3>
                                    <p>Try adjusting your search criteria</p>
                                </div>
                                <% } %>

                                    <% if (pages> 0) { %>
                                        <nav class="ml-3 mb-2">
                                            <ul class="pagination">
                                                <% if (current==1) { %>
                                                    <li class="page-item disabled"><a class="page-link">First</a></li>
                                                    <% } else { %>
                                                        <li class="page-item">
                                                            <a href="/user/<%= currentUser.username %>/books/<%=filter%>/<%=value%>/1"
                                                                class="page-link">First</a>
                                                        </li>
                                                        <% } %>

                                                            <% var i=(Number(current)> 5 ? Number(current) - 4 : 1) %>
                                                                <% if (i !==1) { %>
                                                                    <li class="page-item disabled"><a
                                                                            class="page-link">...</a></li>
                                                                    <% } %>

                                                                        <% for (; i <=(Number(current) + 4) && i
                                                                            <=pages; i++) { %>
                                                                            <% if (i==current) { %>
                                                                                <li class="page-item active"><a
                                                                                        class="page-link">
                                                                                        <%= i %>
                                                                                    </a></li>
                                                                                <% } else { %>
                                                                                    <li class="page-item">
                                                                                        <a class="page-link"
                                                                                            href="/user/<%= currentUser.username %>/books/<%=filter%>/<%=value%>/<%= i %>">
                                                                                            <%= i %>
                                                                                        </a>
                                                                                    </li>
                                                                                    <% } %>
                                                                                        <% if (i==Number(current) + 4 &&
                                                                                            i < pages) { %>
                                                                                            <li
                                                                                                class="page-item disabled">
                                                                                                <a
                                                                                                    class="page-link">...</a>
                                                                                            </li>
                                                                                            <% } %>
                                                                                                <% } %>

                                                                                                    <% if
                                                                                                        (current==pages)
                                                                                                        { %>
                                                                                                        <li
                                                                                                            class="page-item disabled">
                                                                                                            <a
                                                                                                                class="page-link">Last</a>
                                                                                                        </li>
                                                                                                        <% } else { %>
                                                                                                            <li
                                                                                                                class="page-item">
                                                                                                                <a href="/user/<%= currentUser.username %>/books/<%=filter%>/<%=value%>/<%= pages %>"
                                                                                                                    class="page-link">Last</a>
                                                                                                            </li>
                                                                                                            <% } %>
                                            </ul>
                                        </nav>
                                        <% } %>
                    </div>
                </section>

                <%- include ('../../partials/footer.ejs') %>
    </body>